# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           meson 1.0
PortGroup           qt5 1.0
PortGroup           locale_select 1.0

name                AppStream
version             0.16.4
license             LGPL-2+
categories          devel
maintainers         gmail.com:rjvbertin openmaintainer
platforms           linux
homepage            https://www.freedesktop.org/wiki/Distributions/AppStream/

description         A library to work with AppStream metadata

long_description    AppStream is a cross-distro effort for providing metadata for software \
                    in the (Linux) ecosystem. It provides a convenient way to get information \
                    about non-installed software, and is one of the building blocks for software \
                    centres. It consists of specifications for things like upstream metainfo files, \
                    a unified software metadata pool for distributors, screenshot services and \
                    various other useful bits needed to create user-friendly software-centres or \
                    other tools requiring rich metadata for software and other content.
master_sites        https://www.freedesktop.org/software/appstream/releases/
use_xz              yes

checksums           rmd160  f926706d7b651753412c667f17d0f73aa66d6a7f \
                    sha256  d4f722d79c6a2f29d9dc5c6f464927469543353f386581c778c9bed7c60a54ed
#                     size    2570176

depends_build-append  \
                    port:pkgconfig \
                    port:gperf

depends_lib-append \
                    path:lib/pkgconfig/glib-2.0.pc:glib2 \
                    port:gobject-introspection \
                    port:libxml2 \
                    port:libyaml \
                    port:libstemmer \
                    port:lmdb

patchfiles-append   patch-support-gcc.diff \
                    patch-support-older-qt5.diff \
                    patch-support-older-systemd.diff

compiler.cxx_standard   2014
configure.cxxflags-append \
                    -std=gnu++14

# attempt to fix build on 10.6 by blacklisting troublesome compilers
compiler.blacklist-append  *gcc-3.* *gcc-4.* {clang < 300}

configure.ldflags-append -lintl
# prevent a build conflict with the previous version:
# (the current version no longer installs to that location)
configure.ldflags-delete \
                     -Wl,-rpath,${prefix}/lib/x86_64-linux-gnu

# gobject-introspection uses g-ir-scanner, which uses $CC from env
build.env-append    "CC=${configure.cc}"
destroot.env-append "CC=${configure.cc}"

configure.args      -Dqt=true \
                    -Dvapi=true \
                    -Dapidocs=false \
                    -Dapt-support=true

post-destroot {
    if {[file exists ${prefix}/lib/x86_64-linux-gnu/libappstream.so.4]} {
        # dependents may look for our libraries in this location:
        xinstall -m 755 -d ${destroot}${prefix}/lib/x86_64-linux-gnu
        ln -s ../libappstream.so.4 ${destroot}${prefix}/lib/x86_64-linux-gnu/
        ln -s ../libAppStreamQt.so.2 ${destroot}${prefix}/lib/x86_64-linux-gnu/
    }
}

destroot.violate_mtree yes
