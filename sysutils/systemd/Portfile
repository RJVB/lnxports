# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:filetype=tcl:et:sw=4:ts=4:sts=4

PortSystem 1.0
PortGroup       meson 1.0
PortGroup       LTO 1.0

set realName    systemd
name            ${realName}

set orig.version 255.4
set ubuntu.version 1ubuntu8.17
set ubuntu.name noble
version         ${orig.version}.${ubuntu.version}
description     The systemd meta-package
long_description \
                Corresponds to the following Ubuntu \"${ubuntu.name}\" packages: \
                systemd systemd-boot systemd-boot-efi systemd-container \
                systemd-coredump systemd-dev systemd-homed systemd-journal-remote \
                systemd-oomd systemd-resolved systemd-standalone-sysusers \
                systemd-standalone-tmpfiles systemd-sysv systemd-tests systemd-timesyncd \
                systemd-userdbd libnss-mymachines libnss-resolve libnss-systemd \
                libpam-systemd libsystemd-dev libsystemd-shared libsystemd0 \
                libudev-dev libudev1 udev

homepage        https://launchpad.net/ubuntu/${ubuntu.name}/+source/${realName}
license         GPL-2
platforms       linux

master_sites    https://launchpad.net/ubuntu/+archive/primary/+files/
distname        ${realName}_${orig.version}.orig
checksums       rmd160 d165bc4647bc06a0eb2e2ea800c6c0ba82019559 \
                sha256 96e75bd08c57ad401677456fb88ef54a9f05bb1695693013bc6ecce839640fd5
worksrcdir      ${realName}-stable-${orig.version}

# an undoubtedly tiny selection of all required dependencies; debian/control lists:
#                pkg-config,
#                xsltproc,
#                docbook-xsl,
#                docbook-xml,
#                m4,
#                meson (>= 0.40.0),
#                intltool,
#                gperf,
#                gnu-efi [amd64 i386 arm64],
#                libcap-dev (>= 1:2.24-9~),
#                libpam0g-dev,
#                libapparmor-dev (>= 2.9.0-3+exp2) <!stage1>,
#                libidn11-dev <!stage1>,
#                libiptc-dev <!stage1> | iptables-dev <!stage1>,
#                libaudit-dev <!stage1>,
#                libdbus-1-dev (>= 1.3.2) <!nocheck>,
#                libcryptsetup-dev (>= 2:1.6.0) <!stage1>,
#                libselinux1-dev (>= 2.1.9),
#                libacl1-dev,
#                liblzma-dev,
#                liblz4-dev (>= 0.0~r125),
#                liblz4-tool <!nocheck>,
#                libbz2-dev <!stage1>,
#                zlib1g-dev <!stage1> | libz-dev <!stage1>,
#                libcurl4-gnutls-dev <!stage1> | libcurl-dev <!stage1>,
#                libmicrohttpd-dev <!stage1>,
#                libgnutls28-dev <!stage1>,
#                libgcrypt20-dev,
#                libkmod-dev (>= 15),
#                libblkid-dev (>= 2.24),
#                libmount-dev (>= 2.27.1),
#                libdw-dev (>= 0.158) <!stage1>,
#                libpolkit-gobject-1-dev <!stage1>,
#                linux-base <!nocheck>,
#                acl <!nocheck>,
#                python3:native,
#                python3-lxml:native,
#                python3-pyparsing <!nocheck>,
#                tzdata <!nocheck>,
#                libcap2-bin <!nocheck>,
#                iproute2 <!nocheck>,

set py_ver      3.11
set py_nodot_ver 311

depends_build-append \
                port:pkgconfig \
                port:m4 \
                port:gperf \
                port:perl5 \
                port:python${py_nodot_ver} \
                port:py${py_nodot_ver}-lxml \
                port:py${py_nodot_ver}-jinja2 \
                port:py${py_nodot_ver}-pefile
depends_lib-append \
                port:gettext \
                port:zlib \
                port:bzip2 \
                port:xz \
                port:libxslt \
                port:curl \
                port:lz4 \
                port:lzo2 \
                port:libpcap \
                port:gnutls \
                port:libgpg-error \
                port:libgcrypt \
                port:util-linux

# Ubuntu's patches:
patch.pre_args  -Np1
patchfiles-append \
                patch-use-python311.diff \
                patch-resolvedmanager.diff
# patchfiles-append \
#                 patch-include-order-fix.diff

if {[file exists ${filespath}/debian/series]} {
    foreach p [exec cat ${filespath}/debian/series] {
        patchfiles-append debian/${p}
    }
}

configure.cflags-append \
                -ftrapv \
                -Wno-error=nonnull

## these were already non-recognised in systemd 234:
#                 --enable-compat-libs
#                 --enable-kdbus
#                 --enable-tcpwrap
#                 --disable-keymap
## these have gone:
#                 --with-efi-libdir=${prefix}/lib
#                 --with-efi-ldsdir=${prefix}/lib
#                 --with-efi-includedir=${prefix}/include
configure.args-append \
                --sysconfdir ${prefix}/etc \
                --localstatedir /var \
                --libdir ${prefix}/lib \
                --datadir ${prefix}/share \
                -Dselinux=disabled \
                -Dapparmor=disabled \
                -Drootprefix=${prefix} \
                -Ddbuspolicydir=${prefix}/share/dbus-1/system.d \
                -Ddbussessionservicedir=${prefix}/share/dbus-1/services \
                -Ddbussystemservicedir=${prefix}/share/dbus-1/system-services \
                -Ddbus-interfaces-dir=${prefix}/share/dbus-1/interfaces \
                -Dpamlibdir=/lib/security \
                -Dpamconfdir=/etc/pam.d \
                -Dbashcompletiondir=${prefix}/share/bash-completion/completions \
                -Dhwdb=true \
                -Dman=enabled
# preserve the default hierarchy used in the previous port version:
configure.args-append \
                -Ddefault-hierarchy=hybrid

platform linux {
    configure.ldflags-append -Wl,-rpath=${prefix}/lib  -Wl,-rpath=${prefix}/lib/systemd -lintl
    build.env-append LDFLAGS=-Wl,-rpath=${prefix}/lib  -Wl,-rpath=${prefix}/lib/systemd
    destroot.env-append LDFLAGS=-Wl,-rpath=${prefix}/lib  -Wl,-rpath=${prefix}/lib/systemd
}

build.pre_args-prepend \
                -k 0
destroot.violate_mtree \
                yes

post-destroot {
    foreach b [glob -nocomplain ${destroot}/bin/*] {
        file rename ${b} ${destroot}${prefix}/bin
    }

    # these I don't like to provide:
    foreach b {telinit shutdown runlevel reboot poweroff init halt} {
        file delete ${destroot}${prefix}/sbin/${b}
        file delete ${destroot}${prefix}/share/man/man8/${b}.8
    }

    file delete ${destroot}/etc/init.d/README
    file delete ${destroot}/var/log/README
}

livecheck.type none
