github.setup    nelhage reptyr e294304ae065e9de52769c0e21e3ed8106c2fbde
fetch.type      git
version         0.10.0.5
distname        ${name}-git

categories      sysutils
platforms       linux
license         MIT
maintainers     openmaintainer
description     Reparent a running program to a new terminal
long_description \
                reptyr is a utility for taking an existing running program and attaching it to a new terminal. \
                Started a long-running process over ssh, but have to leave and don't want to interrupt it? \
                Just start a screen, use reptyr to grab it, and then kill the ssh session and head on home.

